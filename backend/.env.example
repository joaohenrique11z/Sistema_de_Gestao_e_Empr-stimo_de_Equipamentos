APP_NAME="Sistema de Gestão e Empréstimo de Equipamentos"
APP_ENV="development"

# Banco de dados (SQLite em desenvolvimento, PostgreSQL em staging/produção)
# Ex.: DATABASE_URL="postgresql+psycopg://postgres:postgres@db:5432/equipamentos"
DATABASE_URL="sqlite:///./equipamentos.db"
DATABASE_ECHO="false"

# Autenticação JWT (defina uma chave com >= 32 caracteres em produção)
JWT_SECRET_KEY="altere-esta-chave-secreta-em-producao"
JWT_ALGORITHM="HS256"
JWT_ISSUER="equipamentos-api"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Proteção contra força bruta (bloqueio de conta)
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Rate limiting (slowapi)
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_STORAGE_URI="memory://"
RATE_LIMIT_DEFAULT="120/minute"
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REFRESH="10/minute"

# CORS (origens permitidas separadas por vírgula ou lista JSON)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Utilizador administrador inicial (opcional - criado no arranque se definido)
FIRST_ADMIN_NOME="Administrador"
FIRST_ADMIN_EMAIL=""
FIRST_ADMIN_PASSWORD=""
